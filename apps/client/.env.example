# Mastra Studio is served by `pnpm dev` at http://localhost:4111 by default.
# A Mastra model identifier. Example: openai/gpt-4.1-mini
MASTRA_MODEL=openai/gpt-4.1-mini
# Provide credentials required by the selected model provider.
OPENAI_API_KEY=

# Streamable HTTP MCP endpoint exposed by apps/portmax_api.
PORTMAX_MCP_URL=http://127.0.0.1:3001/mcp
