# The only upstream origin portmax_api will contact. Required for /proxy/* and MCP tool calls.
# The token route appends /api/blade-auth/oauth/token. Match the legacy Vite default with V2;
# change to http://dev.v3.portmax.com when TARGET_ENV=v3 is required.
PORTMAX_UPSTREAM_BASE_URL=http://dev.v2.portmax.com
# Optional service-to-service authorization injected into all upstream requests.
# PORTMAX_UPSTREAM_AUTHORIZATION=Bearer replace-me
# Required for POST /auth/token. Keep the Blade OAuth client credential server-side.
# PORTMAX_BLADE_OAUTH_AUTHORIZATION=Basic replace-with-base64-client-id-colon-client-secret
PORT=3001
PORTMAX_BLADE_OAUTH_AUTHORIZATION=Basic c2FiZXI6c2FiZXJfc2VjcmV0